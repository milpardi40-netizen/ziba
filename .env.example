# Real backend (Supabase) — copy to `.env.local` for local development.
# In production these come from GitHub repository secrets
# (Settings → Secrets and variables → Actions) and are injected by
# .github/workflows/deploy.yml at build time.
#
# Both values are PUBLIC-safe: the anon key is guarded by Row Level
# Security (see supabase/schema.sql). Never put the service_role key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
